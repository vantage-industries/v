# --- possible Nmap scan detection ---

alert tcp any any -> $HOME_NET any (msg:"POSSIBLE NMAP Scan"; flags:0; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000010; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"POSSIBLE NMAP Scan"; flags:F; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000011; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"POSSIBLE NMAP Scan"; flags:FPU; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000012; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"POSSIBLE NMAP Scan"; flags:A; ack:0; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000013; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"POSSIBLE NMAP Scan (small TCP window)"; flags:S; tcp.hdr; byte_test:2,<,2048,14,big; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000015; rev:1;)
