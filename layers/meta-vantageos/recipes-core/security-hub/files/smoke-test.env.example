# Copy to /etc/securityhub/smoke-test.env (mode 0600) after completing /setup/bootstrap to
# let security-hub-smoke-test.timer run the one-time smoke test:
#
#   cp /etc/securityhub/smoke-test.env.example /etc/securityhub/smoke-test.env
#   chmod 0600 /etc/securityhub/smoke-test.env
#   vi /etc/securityhub/smoke-test.env
#
# Absent this file, the timer keeps polling and does nothing (see
# security-hub-smoke-test-runner.sh).
PASSWORD=
