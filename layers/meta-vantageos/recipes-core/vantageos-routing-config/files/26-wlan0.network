[Match]
Name=wlan0

[Network]
# Routed, not bridged: brcmfmac (onboard Pi 5 radio) rejects bridge
# enslavement outright (`ip link set wlan0 master ...` -> EOPNOTSUPP,
# confirmed on-device). Guest is a plain routed subnet off wlan0 instead,
# same model as eth0/tailscale0 in routing-setup.sh (matched by interface
# name in nft, no bridge involved).
Address=192.168.20.1/24
LinkLocalAddressing=no
RequiredForOnline=no
